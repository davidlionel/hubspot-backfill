# Private app token from a HubSpot developer test account.
# Settings > Integrations > Private Apps > Create a private app
#
# Required scopes:
#   crm.objects.deals.read
#   crm.objects.deals.write
#   crm.schemas.deals.read
#   crm.schemas.deals.write
#
# Developer API keys do not work against a test account.
HUBSPOT_TOKEN=your-private-app-token-here